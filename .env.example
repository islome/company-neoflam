# Copy to .env.local and fill in. Add the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000



# Optional: Higgsfield AI hero video (mp4/webm URL, e.g. from Supabase Storage)
NEXT_PUBLIC_HERO_VIDEO_URL=

# 3D Studio (/[lang]/studio): staff password. Leave empty to switch the Studio off.
STUDIO_PASSWORD=
