# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Higgsfield AI hero video (mp4/webm URL, e.g. from Supabase Storage)
NEXT_PUBLIC_HERO_VIDEO_URL=
